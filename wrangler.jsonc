{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rsvp-draft-v2",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "MY_VAR": "my-variable"
  },
  "assets": {
    "directory": "./src/public"
  }
